# Backend Python Server with Sqlite3 DB.
SERVER=http://10.216.169.120:5000

# machine status configuration 
# shared by machine-status, machine-reserve, machine-release, machine-report scripts
TARGET_MSG="/usr/local/etc/machine-status.msg"
STATUS_TEMPLATE="/usr/local/etc/machine-status.template"
MACHINE_STATUS_LOG="/var/log/machine-status.log"

# machine-usage configuration
# shared by log_usage.sh and analyzer.sh scripts
DRY_RUN=1
BASE=/var/log
USAGE_LOG=$BASE/machine-usage.csv
SYSADMIN_LOG=$BASE/machine-sysadmin-alerts.log
STATE_FILE=$BASE/machine-usage-state.txt
SYSADMIN_EMAIL=upawar@amd.com
IDLE_CPU_THRESHOLD=90
LOAD_THRESHOLD=0.20
WINDOW_HOURS=24
STALE_HOURS=24
IDLE_MAX_ACTIVE_PCT=10
MIN_POINTS_PER_WINDOW=10
RELEASE_CONFIRM=21
INFO_PCT=20
